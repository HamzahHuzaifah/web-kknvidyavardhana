# Tetapkan index.html sebagai file indeks utama agar halaman root (/) tidak blank
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Teruskan Authorization Header ke Node.js (mencegah Apache/LiteSpeed men-strip header token)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Reverse Proxy: teruskan semua request /api dan /uploads ke Node.js port 5000
  RewriteRule ^api/?(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
  RewriteRule ^uploads/?(.*)$ http://127.0.0.1:5000/uploads/$1 [P,L]

  # 2. Dynamic Open Graph / WhatsApp / Facebook / Twitter / Telegram Link Previews
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Facebot|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|Pinterest|Googlebot|bingbot|Applebot) [NC,OR]
  RewriteCond %{QUERY_STRING} (crawler|share|bot) [NC]
  RewriteRule ^(berita|publikasi|jurnal|modul|portofolio|portfolio|profil)/(.+)$ http://127.0.0.1:5000/share/$1/$2 [P,L]

  # 3. Jika file fisik benar-benar ada (file css, js, svg, gambar), langsung sajikan
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. SPA Fallback: semua rute halaman React diarahkan ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cegah browser menyimpan cache index.html agar update baru LANGSUNG muncul
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache asset statis ber-hash aman selama 1 tahun
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
